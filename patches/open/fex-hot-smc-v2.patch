 FEXCore/include/FEXCore/Utils/HotSMCPages.h   | 147 +++++++++++++++++-
 Source/Windows/Common/InvalidationTracker.cpp |  93 +++++++++--
 Source/Windows/Common/InvalidationTracker.h   |   9 +-
 4 files changed, 236 insertions(+), 22 deletions(-)

